{{ with secret "secret/nexus/cera-deployer" }}
    export SNYK_TOKEN="{{ .Data.data.password }}"
    export SONAR_TOKEN="{{ .Data.data.password }}"

    echo "export SNYK_TOKEN=\"{{ .Data.data.password }}\"" >> $BASH_ENV
    echo "export SONAR_TOKEN=\"{{ .Data.data.password }}\"" >> $BASH_ENV
{{ end }}
