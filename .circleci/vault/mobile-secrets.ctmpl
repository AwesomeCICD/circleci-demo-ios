{{ with secret "secret/mobile/bcp-demo" }}
    export SNYK_TOKEN="{{ .Data.data.snyk_token }}"
    export SONAR_TOKEN="{{ .Data.data.sonar_token }}"
    export SONAR_PROJECT_KEY="{{ .Data.data.sonar_project_key }}"

    echo "export SNYK_TOKEN=\"{{ .Data.data.snyk_token }}\"" >> $BASH_ENV
    echo "export SONAR_TOKEN=\"{{ .Data.data.sonar_token }}\"" >> $BASH_ENV
    echo "export SONAR_PROJECT_KEY=\"{{ .Data.data.sonar_project_key }}\"" >> $BASH_ENV
{{ end }}
