# Copy to .env for local runs. All values are OPTIONAL: with none set, the
# pipeline runs in demo mode (ad-hoc signing + a deterministic notarization gate).

# --- Code signing (macOS Developer ID Application) ---
# Set to use a real Developer ID instead of ad-hoc signing.
MACOS_SIGN_IDENTITY="Developer ID Application: Your Company (TEAMID)"

# --- Apple notarization (App Store Connect API key) ---
# Set ALL of these to perform real notarytool submission + stapling.
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_API_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_CONTENT=   # base64 of the .p8 key file
APPLE_TEAM_ID=

# --- External artifact storage (used only when publish-external=true) ---
# S3 here; maps directly to Azure Blob in the Starbucks environment.
AWS_ROLE_ARN=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
